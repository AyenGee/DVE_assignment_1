     },
     "execution_count": 22,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "US_GALLON_TO_LITRES = 3.785411784\n",
    "MILE_TO_KM = 1.609344\n",
    "\n",
    "df[\"litres_filled\"] = df[\"gallons\"] * US_GALLON_TO_LITRES\n",
    "df[\"km_driven\"] = df[\"miles\"] * MILE_TO_KM\n",
    "df[\"litres_per_100km\"] = (df[\"litres_filled\"] / df[\"km_driven\"]) * 100\n",
    "\n",
    "df[[\"gallons\", \"litres_filled\", \"miles\", \"km_driven\", \"mpg\", \"litres_per_100km\"]].sample(5, random_state=1)"
   ]
  },
