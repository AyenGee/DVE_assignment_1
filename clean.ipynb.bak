   "id": "7101c4b0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1197 rows (0.102%) have date_fueled before 2005 or in the future\n",
      "(1173673, 9)\n"
     ]
    }
   ],
   "source": [
    "today = pd.Timestamp.today().normalize()\n",
    "out_of_range = df[\"date_fueled\"].notna() & (\n",
    "    (df[\"date_fueled\"] < \"2005-01-01\") | (df[\"date_fueled\"] > today)\n",
    ")\n",
    "print(f\"{out_of_range.sum()} rows ({out_of_range.mean()*100:.3f}%) have date_fueled before 2005 or in the future\")\n",
    "\n",
    "df = df.loc[~out_of_range].copy()\n",
    "print(df.shape)"
   ]
  },
