      "text/plain": [
       "         gallons  litres_filled     miles   km_driven   mpg  litres_per_100km\n",
       "808512    15.058      57.000731  525.5242  845.749218  34.9          6.739673\n",
       "475805    11.932      45.167533  260.1176  418.618699  21.8         10.789660\n",
       "580852    12.038      45.568787  299.7462  482.394748  24.9          9.446369\n",
       "1115724   12.714      48.127725  256.8228  413.316232  20.2         11.644286\n",
