   ],
   "source": [
    "# one row per user (their car_make/car_model is a profile attribute, not a per-transaction one)\n",
    "vehicle_profiles = df.drop_duplicates(subset=\"user_url\")[[\"car_make\", \"car_model\"]]\n",
    "\n",
    "top_makes = vehicle_profiles[\"car_make\"].value_counts().head(15)\n",
    "top_models = vehicle_profiles.groupby([\"car_make\", \"car_model\"]).size().sort_values(ascending=False).head(15)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "top_makes.plot(kind=\"barh\")\n",
    "plt.gca().invert_yaxis()\n",
    "plt.xlabel(\"number of unique users\")\n",
    "plt.title(\"Most popular vehicle makes\")\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "top_models.plot(kind=\"barh\")\n",
    "plt.gca().invert_yaxis()\n",
    "plt.xlabel(\"number of unique users\")\n",
    "plt.title(\"Most popular make/model combinations\")\n",
    "plt.show()"
   ]
  },
