   "source": [
    "## Q1.2.1\n",
    "gallons: 6.32% missing\n",
    "miles: 87.58% missing\n",
    "odometer: 12.67% missing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "696ebe68",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "gallons     float64\n",
       "miles       float64\n",
       "odometer    float64\n",
       "mpg         float64\n",
       "dtype: object"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def clean_numeric(series):\n",
    "    cleaned = series.astype(str).str.replace(\",\", \"\", regex=False).str.strip()\n",
    "    return pd.to_numeric(cleaned, errors=\"coerce\")\n",
    "\n",
    "for col in [\"gallons\", \"miles\", \"odometer\", \"mpg\"]:\n",
    "    df[col] = clean_numeric(df[col])\n",
    "\n",
    "df[[\"gallons\", \"miles\", \"odometer\", \"mpg\"]].dtypes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "df3189e0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filled 953695 missing miles values\n",
      "Filled 0 missing gallons values\n",
      "Filled 0 missing mpg values\n",
      "gallons: 6.32% missing after fill\n",
      "miles: 6.32% missing after fill\n",
      "odometer: 12.67% missing after fill\n",
      "mpg: 6.32% missing after fill\n"
     ]
    }
   ],
   "source": [
    "# miles = mpg * gallons\n",
    "mask = df[\"miles\"].isna() & df[\"mpg\"].notna() & df[\"gallons\"].notna()\n",
    "df.loc[mask, \"miles\"] = df.loc[mask, \"mpg\"] * df.loc[mask, \"gallons\"]\n",
    "print(f\"Filled {mask.sum()} missing miles values\")\n",
    "\n",
    "# gallons = miles / mpg\n",
    "mask = df[\"gallons\"].isna() & df[\"mpg\"].notna() & df[\"miles\"].notna() & (df[\"mpg\"] != 0)\n",
    "df.loc[mask, \"gallons\"] = df.loc[mask, \"miles\"] / df.loc[mask, \"mpg\"]\n",
    "print(f\"Filled {mask.sum()} missing gallons values\")\n",
    "\n",
    "# mpg = miles / gallons\n",
    "mask = df[\"mpg\"].isna() & df[\"miles\"].notna() & df[\"gallons\"].notna() & (df[\"gallons\"] != 0)\n",
    "df.loc[mask, \"mpg\"] = df.loc[mask, \"miles\"] / df.loc[mask, \"gallons\"]\n",
    "print(f\"Filled {mask.sum()} missing mpg values\")\n",
    "\n",
    "for col in [\"gallons\", \"miles\", \"odometer\", \"mpg\"]:\n",
    "    print(f\"{col}: {df[col].isna().mean()*100:.2f}% missing after fill\")"
   ]
  },
