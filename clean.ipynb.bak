   "source": [
    "#2.1 New Column with currency:\n",
    "# rows with currency == NaN likely correspond to non-fuel (maintenance/service) log entries rather than data-entry failures.\n",
    "df[\"currency\"] = df[\"total_spent\"].str.extract(r\"^(\\D+)\")[0].str.strip()\n",
    "df[\"currency\"] = df[\"currency\"].fillna(df[\"cost_per_gallon\"].str.extract(r\"^(\\D+)\")[0].str.strip())\n",
    "\n",
    "print(df[\"currency\"].value_counts(dropna=False).head(20))"
   ]
  },
