   "source": [
    "df_sorted = df_clean.sort_values([\"user_url\", \"date_fueled\"]).copy()\n",
    "\n",
    "df_sorted[\"prev_odometer\"] = df_sorted.groupby(\"user_url\")[\"odometer\"].shift(1)\n",
    "df_sorted[\"odometer_diff\"] = df_sorted[\"odometer\"] - df_sorted[\"prev_odometer\"]\n",
    "\n",
    "# comparable pairs: real previous reading, valid miles, non-negative & plausible odometer jump\n",
    "comparable = (\n",
    "    df_sorted[\"odometer_diff\"].notna()\n",
    "    & df_sorted[\"miles\"].notna() & (df_sorted[\"miles\"] > 0)\n",
    "    & df_sorted[\"odometer_diff\"].between(0, 5000)\n",
    ")\n",
    "\n",
    "missed_fillup = comparable & (df_sorted[\"odometer_diff\"] > 1.5 * df_sorted[\"miles\"])\n",
    "\n",
    "print(f\"Comparable consecutive fill-up pairs: {comparable.sum()}\")\n",
    "print(f\"Estimated missed fill-ups: {missed_fillup.sum()} ({missed_fillup.sum() / comparable.sum() * 100:.2f}% of comparable pairs)\")\n",
    "\n",
    "df_sorted.loc[missed_fillup, [\"user_url\", \"date_fueled\", \"prev_odometer\", \"odometer\", \"odometer_diff\", \"miles\"]].head(10)"
   ]
  },
