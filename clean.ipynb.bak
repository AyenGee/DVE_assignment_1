    "min_transactions = 20  # need a real sample before trusting a \"most efficient\" claim, not a fluke from 1-2 rows\n",
    "\n",
    "results = {}\n",
    "for cur in top5_list:\n",
    "    group = df_clean[df_clean[\"currency\"] == cur]\n",
    "    stats = group.groupby([\"car_make\", \"car_model\"])[\"litres_per_100km\"].agg([\"mean\", \"count\"])\n",
    "    stats = stats[stats[\"count\"] >= min_transactions]\n",
    "    stats = stats[stats[\"mean\"].between(2, 20)]  # brief's own sanity bound: reject implausible efficiency values\n",
    "    most_efficient = stats.sort_values(\"mean\").head(1)\n",
    "    results[cur] = most_efficient\n",
    "\n",
    "for cur, res in results.items():\n",
    "    print(f\"\\n{cur}:\")\n",
    "    print(res)"
   ]
