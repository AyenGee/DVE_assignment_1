    "sa = df_clean[df_clean[\"currency\"] == \"R\"]\n",
    "\n",
    "# most popular = most unique owners, same logic as Step 16\n",
    "sa_vehicle_counts = sa.drop_duplicates(subset=\"user_url\").groupby([\"car_make\", \"car_model\"]).size().sort_values(ascending=False)\n",
    "top5_sa = sa_vehicle_counts.head(5)\n",
    "print(top5_sa)\n",
    "\n",
    "top5_pairs = top5_sa.index.tolist()\n",
    "sa_top5_mask = pd.MultiIndex.from_arrays([sa[\"car_make\"], sa[\"car_model\"]]).isin(top5_pairs)\n",
    "sa_top5 = sa[sa_top5_mask]\n",
    "\n",
    "efficiency_summary = sa_top5.groupby([\"car_make\", \"car_model\"])[\"litres_per_100km\"].agg([\"mean\", \"median\", \"count\"])\n",
    "efficiency_summary = efficiency_summary.loc[top5_pairs]  # reorder to match popularity ranking\n",
    "print(efficiency_summary)"
   ]
  },
