   "source": [
    "import pandas as pd\n",
    "import numpy as np \n",
    "import matplotlib.pyplot as plt \n",
    "\n",
    "\n",
    "df = pd.read_csv(\"logbook_assignment1.csv\")\n",
    "print(df.shape)\n",
    "df.dtypes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a6d53ecb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "11.62% of date_fueled entries are not valid dates\n"
     ]
    }
   ],
   "source": [
    "parsed_dates = pd.to_datetime(df[\"date_fueled\"], errors=\"coerce\", format=\"mixed\")\n",
    "pct_invalid = parsed_dates.isna().mean() * 100\n",
    "print(f\"{pct_invalid:.2f}% of date_fueled entries are not valid dates\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ce5b065a",
   "metadata": {},
   "source": [
    "## Q1.1.1: Percentage of invalid date_fueled entries\n",
    "11.62% of date_fueled entries are not valid dates"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b8137e6b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "136521 rows (11.62%) get date_captured as a proxy for date_fueled\n"
     ]
    }
   ],
   "source": [
    "parsed_fueled = pd.to_datetime(df[\"date_fueled\"], errors=\"coerce\", format=\"mixed\")\n",
    "parsed_captured = pd.to_datetime(df[\"date_captured\"], errors=\"coerce\", format=\"mixed\")\n",
    "\n",
    "needs_fallback = parsed_fueled.isna() & parsed_captured.notna()\n",
    "print(f\"{needs_fallback.sum()} rows ({needs_fallback.mean()*100:.2f}%) get date_captured as a proxy for date_fueled\")\n",
    "\n",
    "df[\"date_fueled\"] = parsed_fueled.where(~needs_fallback, parsed_captured)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "7c4a9457",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "datetime64[us]\n",
      "0 rows remain NaT after fallback\n"
     ]
    }
   ],
   "source": [
    "print(df[\"date_fueled\"].dtype)\n",
    "print(df[\"date_fueled\"].isna().sum(), \"rows remain NaT after fallback\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4ec36d60",
   "metadata": {},
   "source": [
    "## Q1.1.2:\n",
    "136521 rows (11.62%) get date_captured as a proxy for date_fueled\n",
    "\n",
    "## Q1.1.3:\n",
    "0 rows remain NaT after fallback"
   ]
  },
  {
   "cell_type": "code",
